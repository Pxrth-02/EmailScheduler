generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Char(36)
  googleId     String?  @unique @map("google_id")
  email        String   @unique
  name         String
  avatarUrl    String?  @map("avatar_url") @db.VarChar(1024)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  senders         Sender[]
  campaigns       Campaign[]
  emails          Email[]
  slackConnection SlackConnection?

  @@map("users")
}

/// One SMTP identity a user can send from. Each row is an Ethereal test account.
model Sender {
  id        String   @id @default(uuid(7)) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  email     String
  name      String
  smtpHost  String   @map("smtp_host")
  smtpPort  Int      @map("smtp_port")
  smtpUser  String   @map("smtp_user")
  smtpPass  String   @map("smtp_pass")
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emails    Email[]

  @@unique([userId, email])
  @@map("senders")
}

/// A compose action: one subject/body sent to many recipients on a schedule.
model Campaign {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  senderId    String   @map("sender_id") @db.Char(36)
  subject     String   @db.VarChar(500)
  bodyHtml    String   @map("body_html") @db.MediumText
  startAt     DateTime @map("start_at")
  delayMs     Int      @map("delay_ms")
  hourlyLimit Int      @map("hourly_limit")
  totalCount  Int      @map("total_count")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender  @relation(fields: [senderId], references: [id])
  emails Email[]

  @@index([userId, createdAt])
  @@map("campaigns")
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
}

/// One recipient of a campaign. This is the unit the queue works with: one row, one job.
model Email {
  id          String      @id @default(uuid(7)) @db.Char(36)
  campaignId  String      @map("campaign_id") @db.Char(36)
  userId      String      @map("user_id") @db.Char(36)
  senderId    String      @map("sender_id") @db.Char(36)
  toEmail     String      @map("to_email")
  toName      String?     @map("to_name")
  status      EmailStatus @default(scheduled)
  scheduledAt DateTime    @map("scheduled_at")
  sentAt      DateTime?   @map("sent_at")
  attempts    Int         @default(0)
  messageId   String?     @map("message_id")
  previewUrl  String?     @map("preview_url") @db.VarChar(1024)
  lastError   String?     @map("last_error") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@index([userId, status, scheduledAt])
  @@index([userId, status, sentAt])
  @@index([senderId, status])
  @@index([campaignId])
  @@map("emails")
}

/// Result of the "Connect Slack" OAuth flow: one workspace + channel webhook per user.
model SlackConnection {
  id          String   @id @default(uuid(7)) @db.Char(36)
  userId      String   @unique @map("user_id") @db.Char(36)
  teamId      String   @map("team_id")
  teamName    String   @map("team_name")
  channelName String   @map("channel_name")
  webhookUrl  String   @map("webhook_url") @db.VarChar(1024)
  accessToken String   @map("access_token") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}
