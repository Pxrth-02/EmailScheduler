{
  "name": "email-scheduler-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + BullMQ email scheduling API and worker",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "dev:all": "concurrently -n api,worker -c blue,magenta \"npm:dev\" \"npm:worker\"",
    "load-test": "tsx scripts/load-test.ts",
    "reindex": "tsx scripts/reindex.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@elastic/elasticsearch": "^9.5.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.83.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
