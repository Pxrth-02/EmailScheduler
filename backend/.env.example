# Copy to .env and fill in. Never commit the real file.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Data stores (defaults match docker-compose.yml) ---
# Root is used locally because `prisma migrate dev` needs to create a shadow database.
DATABASE_URL=mysql://root:password@localhost:3306/emailscheduler
REDIS_URL=redis://localhost:6379

# --- URLs ---
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Auth ---
SESSION_SECRET=your_session_secret_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Queue and sending ---
EMAIL_QUEUE_NAME=email-send
# Jobs processed in parallel by one worker process
WORKER_CONCURRENCY=5
# Retry policy for transient SMTP failures (exponential backoff)
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=30000
# Ethereal accounts created for each user on first login ("From" identities)
SENDERS_PER_USER=3
# Optional: pin one Ethereal account you created on https://ethereal.email instead of auto-creating
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Throughput ---
# Floor for the gap between two sends from the same sender (campaigns can ask for more, never less)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Ceiling for emails per sender per wall-clock hour (campaigns can ask for less, never more)
MAX_EMAILS_PER_HOUR_PER_SENDER=3

# --- Slack (optional; without these the "Connect Slack" menu item is disabled) ---
# api.slack.com -> Your Apps -> Create New App -> OAuth & Permissions
#   Bot token scope: incoming-webhook
#   Redirect URL: must be HTTPS, so locally use a tunnel such as `ngrok http 4000`
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your_tunnel_url/auth/slack/callback

# --- Search (optional; without a URL search falls back to MySQL) ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# Only for a hosted cluster with security enabled
ELASTICSEARCH_API_KEY=